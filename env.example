# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# development | production
NODE_ENV=development

# Porta da aplicação
PORT=3000

# ============================================
# DATABASE - PostgreSQL
# ============================================
# Para DESENVOLVIMENTO LOCAL (Docker)
# Use estas variáveis se estiver usando docker-compose
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=thera
DATABASE_PASSWORD=thera123
DATABASE_NAME=thera_db

# Para PRODUÇÃO (Neon PostgreSQL)
# Use a connection string completa do Neon
# Formato com pooler (RECOMENDADO para produção):
DATABASE_URL=postgresql://neondb_owner:password@ep-rough-shadow-ahd60wdq-pooler.c-3.us-east-1.aws.neon.tech/thera-consulting-test?sslmode=require&channel_binding=require

# Para desenvolvimento local sem pooler:
# DATABASE_URL=postgresql://thera:thera123@localhost:5432/thera_db?schema=public

# ============================================
# REDIS - Cache
# ============================================
# Para DESENVOLVIMENTO LOCAL (Docker)
# Use estas variáveis se estiver usando docker-compose
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Para PRODUÇÃO (Upstash Redis)
# Opção 1: REST API (RECOMENDADO para Upstash)
# Obtenha estas credenciais no dashboard do Upstash
REDIS_REST_URL=https://xxx.upstash.io
REDIS_REST_TOKEN=your-upstash-token-here

# Opção 2: Redis Protocol (alternativa)
# Use a URL de conexão completa do Redis
# Formato: redis://default:password@host:port
REDIS_URL=

# Exemplo Upstash com Redis Protocol:
# REDIS_URL=redis://default:password@xxx.upstash.io:6379

# ============================================
# JWT AUTHENTICATION
# ============================================
# IMPORTANTE: Gere uma chave secreta forte para produção!
# Use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Tempo de expiração do token JWT
# Formatos aceitos: 1d, 7d, 1h, 30m, etc.
JWT_EXPIRES_IN=1d

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
# Para desenvolvimento: use * (permite qualquer origem)
# Para produção: especifique os domínios permitidos separados por vírgula
# Exemplo: https://app.example.com,https://admin.example.com
CORS_ORIGIN=*

# ============================================
# SHIPPING API
# ============================================
# URL da API de cálculo de frete
SHIPPING_API_URL=https://showcommerce.com.br/api/calculadora-frete

# ============================================
# INSTRUÇÕES
# ============================================
# 1. Copie este arquivo para .env:
#    cp env.example .env
#
# 2. Configure as variáveis de ambiente:
#    - Para desenvolvimento: use DATABASE_HOST, REDIS_HOST, etc.
#    - Para produção: use DATABASE_URL e REDIS_URL
#
# 3. NUNCA commite o arquivo .env com credenciais reais!
#
# 4. Para gerar JWT_SECRET forte:
#    openssl rand -base64 32
